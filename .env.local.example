# Supabase — get these from your project's Settings > API page.
# NEXT_PUBLIC_ vars are exposed to the browser: only ever put the anon/public key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, NEVER prefix with NEXT_PUBLIC_ and never
# import it into any file a browser could load. Used to send client
# invitation emails via supabase.auth.admin.inviteUserByEmail.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build the invite-email redirect link (e.g. https://clovior.com,
# or http://localhost:3000 for local dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
