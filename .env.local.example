# Supabase — get these from your project's Settings > API page.
# NEXT_PUBLIC_ vars are exposed to the browser: only ever put the anon/public key here.
# The service role key (if you need it later for server-only jobs) must NEVER be
# prefixed NEXT_PUBLIC_ and must only be read in server-side code (API routes, server actions).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
