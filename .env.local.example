# Supabase — get these from your project's Settings > API page.
# NEXT_PUBLIC_ vars are exposed to the browser: only ever put the anon/public key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, NEVER prefix with NEXT_PUBLIC_ and never
# import it into any file a browser could load. Used to send client
# invitation emails via supabase.auth.admin.inviteUserByEmail.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build the invite-email redirect link (e.g. https://clovior.com,
# or http://localhost:3000 for local dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 — S3-compatible storage for recorded videos. Create a bucket
# and an API token (R2 > Manage API Tokens) with read+write on that bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# The bucket's public base URL (R2 > bucket > Settings > Public Access), used
# to build the URL stored in videos.storage_url. No trailing slash.
R2_PUBLIC_URL=

# Deepgram — server-only, used to transcribe recorded videos after upload.
DEEPGRAM_API_KEY=

# Anthropic — server-only, used to summarize transcripts into the AI Summary
# shown on each video.
ANTHROPIC_API_KEY=

# Set this in Vercel's project settings (not committed) — Vercel then sends
# it automatically as `Authorization: Bearer <value>` on every Cron Job
# request, which /api/cron/daily-maintenance checks to reject non-Vercel
# callers. Generate any long random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Stripe — server-only. Get the secret key from the Stripe Dashboard
# (Developers > API keys). Plan prices are created inline in code
# (price_data) so no separate Price IDs are needed.
STRIPE_SECRET_KEY=
# From Stripe Dashboard > Developers > Webhooks, after adding an endpoint
# pointed at https://yourdomain.com/api/stripe/webhook (or via `stripe
# listen` locally, which prints a temporary one for local testing).
STRIPE_WEBHOOK_SECRET=
